## TanStack Query + GraphQL — Ek Saath Kaise Use Karte Hain

TanStack Query React mein **caching, refetching, loading states** handle karta hai.  
GraphQL **query language** hai jo data structure define karta hai.  
Dono ek saath use ho sakte hain — ek doosre ke badle nahi.

```javascript
// TanStack Query + Linear GraphQL — React component mein
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';

// 1. Custom hook — issues fetch karna
function useMyIssues() {
  return useQuery({
    queryKey: ['my-issues'],          // cache key
    queryFn: async () => {
      const data = await linearQuery(`
        query {
          viewer {
            assignedIssues(filter: {
              state: { type: { neq: "completed" } }
            }) {
              nodes {
                id title priority
                state { name }
              }
            }
          }
        }
      `);
      return data.viewer.assignedIssues.nodes;
    },
    staleTime: 5 * 60 * 1000,        // 5 minute fresh rahega
    refetchOnWindowFocus: true,       // tab switch karo to refresh
  });
}

// 2. Mutation — naya issue banana
function useCreateIssue() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: ({ title, teamId }) => linearQuery(`
      mutation($title: String!, $teamId: String!) {
        createIssue(input: { title: $title, teamId: $teamId, priority: 2 }) {
          success
          issue { id title }
        }
      }
    `, { title, teamId }),

    onSuccess: () => {
      // Issue bana → cache invalidate karo → fresh data fetch hoga
      queryClient.invalidateQueries({ queryKey: ['my-issues'] });
    }
  });
}

// 3. Component mein use karo
function IssuesDashboard() {
  const { data: issues, isLoading } = useMyIssues();
  const createIssue = useCreateIssue();

  if (isLoading) return <Spinner />;

  return (
    <div>
      {issues.map(issue => (
        <div key={issue.id}>
          <span>{issue.title}</span>
          <span className={`priority-${issue.priority}`}>P{issue.priority}</span>
        </div>
      ))}

      <button onClick={() => createIssue.mutate({
        title: "Naya bug",
        teamId: "TEAM-ID"
      })}>
        Issue Banao
      </button>
    </div>
  );
}
```

