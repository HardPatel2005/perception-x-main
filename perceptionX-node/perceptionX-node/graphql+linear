### 3. PAGINATION — Saare Results Lena (Relay Cursor Style)

Linear mein ek baar mein max ~50 results milte hain. Zyada ke liye pagination chahiye.

```
Socho pages ki tarah:
  Page 1 → 50 issues → endCursor = "abc123"
  Page 2 → after: "abc123" → 50 more → endCursor = "def456"
  Page 3 → after: "def456" → 30 issues → hasNextPage = false → DONE
```

```graphql
# Pehla page
query {
  issues(first: 50) {
    nodes {
      id
      title
    }
    pageInfo {
      hasNextPage    # true/false — aur page hai?
      endCursor      # "abc123" — next page ke liye yahi pass karo
    }
  }
}

# Agla page — endCursor pass karo
query {
  issues(first: 50, after: "abc123") {
    nodes {
      id
      title
    }
    pageInfo {
      hasNextPage
      endCursor
    }
  }
}
```

```javascript
// Saare issues ek baar mein fetch karo — automatic pagination
async function getAllIssues(teamId) {
  let allIssues = [];
  let cursor = null;      // null = pehli baar, koi cursor nahi
  let hasMore = true;

  while (hasMore) {
    const data = await linearQuery(`
      query($teamId: String!, $after: String) {
        team(id: $teamId) {
          issues(first: 50, after: $after) {
            nodes {
              id
              title
              priority
              state { name }
              assignee { name }
            }
            pageInfo {
              hasNextPage
              endCursor
            }
          }
        }
      }
    `, { teamId, after: cursor });

    const { nodes, pageInfo } = data.team.issues;

    allIssues.push(...nodes);           // is page ke issues add karo
    hasMore = pageInfo.hasNextPage;     // aur hai?
    cursor = pageInfo.endCursor;        // cursor update karo

    console.log(`${allIssues.length} issues fetch hue ab tak...`);
  }

  return allIssues;
}

const issues = await getAllIssues("TEAM-ENG-ID");
console.log(`Total: ${issues.length} issues`);
```

