### 2. MUTATION — Data Banana/Badalna (POST/PUT/DELETE jaisa)

```graphql
# Naya issue create karo
mutation {
  createIssue(input: {
    teamId: "TEAM-ID-HERE"
    title: "Login page pe bug hai"
    priority: 1        # 1 = Urgent
  }) {
    success
    issue {
      id
      title
    }
  }
}
```

```graphql
# Issue update karo
mutation {
  updateIssue(
    id: "ISS-123",
    input: {
      stateId: "STATE-DONE-ID"
      priority: 3
    }
  ) {
    success
    issue {
      id
      title
      state { name }
    }
  }
}
```

```javascript
// JavaScript mein mutation
async function createBug(teamId, title, description) {
  const data = await linearQuery(`
    mutation CreateIssue($teamId: String!, $title: String!, $desc: String) {
      createIssue(input: {
        teamId: $teamId
        title: $title
        description: $desc
        priority: 1
        labelIds: ["LABEL-BUG-ID"]
      }) {
        success
        issue {
          id
          title
          url      # Linear mein directly open karne ka link
        }
      }
    }
  `, { teamId, title, desc: description });

  if (data.createIssue.success) {
    console.log(`Issue bana: ${data.createIssue.issue.url}`);
    return data.createIssue.issue;
  }
}

// Call karo
await createBug("TEAM-ENG", "Payment gateway crash ho raha hai", "Steps to reproduce...");
```

