## Filtering — Exactly Kya Chahiye

```graphql
# Sirf urgent aur high priority issues (priority 1 aur 2)
query {
  issues(filter: {
    priority: { lte: 2, neq: 0 }
    # lte = less than or equal to 2
    # neq = not equal to 0 (0 = unset/no priority)
  }) {
    nodes {
      id
      title
      priority
    }
  }
}
```

```graphql
# Mujhe assign issues jo complete nahi hue
query {
  viewer {
    assignedIssues(filter: {
      state: {
        type: { neq: "completed" }    # completed nahi
      }
    }) {
      nodes {
        id
        title
        state { name }
      }
    }
  }
}
```

```graphql
# Security ya Bug label wale issues
query {
  viewer {
    assignedIssues(filter: {
      labels: {
        name: { in: ["Security", "Bug"] }   # in = list mein se koi ek
      }
    }) {
      nodes {
        id
        title
        priority
      }
    }
  }
}
```

