# PerceptionX Environment Configuration
# Copy this to .env and fill in your values

# ========== CORE ==========
NODE_ENV=development
PYTHON_ENV=development
PORT=3000

# ========== DATABASE ==========
# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/perceptionx?appName=perceptionx
MONGO_DB_NAME=perceptionx

# ========== CLOUDINARY (Image/Video Storage) ==========
# Get from: https://cloudinary.com/console/settings/credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key_12345678901234
CLOUDINARY_API_SECRET=your_api_secret_abcdef123456789

# Optimized for large file uploads (46MB+)
CLOUDINARY_CHUNK_SIZE=3145728           # 3MB chunks (prevents ECONNRESET errors)
CLOUDINARY_UPLOAD_TIMEOUT_MS=1200000    # 20 minutes

# ========== MODAL GPU (Video Processing) ==========
# 1. Get tokens: Run `modal token new` in terminal
# 2. Copy token ID and secret from ~/.modal/token_id.txt and ~/.modal/token_secret.txt
USE_MODAL_GPU=true
MODAL_SECRET_NAME=perceptionx-secrets
MODAL_APP_NAME=perceptionx-video-processor
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here

# Fallback to CPU if Modal fails (slower, but works)
USE_CPU_FALLBACK=true

# ========== SERVICE INTEGRATION ==========
PYTHON_API_URL=http://localhost:8001
PY_SERVICE_URL=http://localhost:8001

# ========== SECURITY ==========
# CHANGE THESE IN PRODUCTION! Use openssl rand -hex 32 to generate
JWT_SECRET=your_long_random_secret_key_change_in_production_please

# ========== CLERK AUTHENTICATION (Optional) ==========
# Get from: https://dashboard.clerk.com/apps
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here

# ========== LOGGING ==========
LOG_LEVEL=INFO
DEBUG=false

# ========== API KEYS FOR EXTERNAL SERVICES ==========
# Add any other API keys your services need here

# ========== SONARCLOUD + LINEAR AUTOMATION ==========
# GitHub Actions uses these values as secrets for the SonarCloud -> Linear sync workflow.
SONAR_ORG=HardPatel
SONAR_PROJECT_KEY=HardPatel2005_perception-x-main
SONAR_TOKEN=89be4be93646de9eb743496aec016c90f57eaa81
LINEAR_API_KEY=lin_api_your_linear_api_key_here
LINEAR_TEAM_ID=your_linear_team_id_here
