# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Keep Windows shell entry points compatible
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common source files should stay LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
